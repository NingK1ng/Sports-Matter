# Replace the server name and frontend path before enabling this site.
# Add your TLS configuration for a public deployment.
server {
    listen 80;
    server_name example.org;
    root /srv/sports-matter/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        # Retrieval plus model generation can exceed nginx's default 60 seconds.
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        # Deliver Assistant SSE tokens as they arrive.
        proxy_buffering off;
    }
    location = /health {
        proxy_pass http://127.0.0.1:8000/health;
        proxy_set_header Host $host;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
    client_max_body_size 100M;
}

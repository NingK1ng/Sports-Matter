# Copy to .env and replace the local-only values before running.
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://sportsmatter:local-only@localhost:5432/sports_matter
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
REDIS_URL=redis://localhost:6379/0
PUBMED_EMAIL=researcher@example.org
SECRET_KEY=replace-with-a-random-local-secret
JWT_SECRET_KEY=replace-with-a-different-random-local-secret

# Add your own credentials to enable external services.
PUBMED_API_KEY=
OPENALEX_EMAIL=
CROSSREF_EMAIL=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
QQ_APP_ID=
QQ_APP_KEY=
YUNGOUOS_MCH_ID=
YUNGOUOS_PAY_KEY=
LOGFIRE_TOKEN=
SENTRY_DSN=

# Optional local data source.
IF_EXCEL_PATH=
